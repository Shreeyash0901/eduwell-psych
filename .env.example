# ============================================================
# EduWell Psych — Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# PostgreSQL Database URL
# For local Docker development, use:
# postgresql://eduwell:<password>@localhost:5432/eduwell_psych?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduwell_psych?schema=public"

# Shadow database URL — used by `prisma migrate dev` for drift detection
# Must point to a separate database (not the main one)
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eduwell_psych_shadow?schema=public"

# Docker Compose credentials (must match DATABASE_URL above)
POSTGRES_DB=eduwell_psych
POSTGRES_USER=eduwell
POSTGRES_PASSWORD=your_local_dev_password

# JWT Authentication configuration
# Use a strong, random secret in production (e.g. openssl rand -base64 32)
JWT_SECRET="eduwell_development_jwt_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Gemini AI API Key — required for AI features (Phase 3+)
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="YOUR_APP_URL"
